{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Student-Athlete Burnout Simulator",
  "version": "0.1.0",
  "identifier": "com.school.burnoutsimulator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Student-Athlete Burnout Simulator",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
